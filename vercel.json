{
  "functions": {
    "api/proxy/**": {
      "regions": ["hkg1"]
    }
  },
  "rewrites": [
    {
      "source": "/proxy/:path*",
      "destination": "/api/proxy/:path*"
    },
    {
      "source": "/s=:query",
      "destination": "/index.html"
    },
    {
      "source": "/player.html/:path*",
      "destination": "/player.html"
    }
  ]
}
